# ── Q-Mate 2.0 environment ──────────────────────────────────────────────
# Copy this file to `.env` (cp .env.example .env) and paste your keys.
# The app works 100% without keys — every AI feature falls back to a
# local heuristic engine. Keys only unlock the Gemini-powered extras.
#
# SECURITY: keys shipped in a frontend bundle are visible to anyone who
# opens DevTools. Restrict each key by HTTP-referrer in Google AI Studio
# and use only for demo / college deployment. NEVER commit .env.

VITE_GEMINI_KEY_1=
VITE_GEMINI_KEY_2=
VITE_GEMINI_KEY_3=
VITE_GEMINI_MODEL=gemini-2.5-flash

# ── MongoDB Atlas (cloud persistence) ───────────────────────────────────
# Paste your Atlas SRV connection string here. The data API tier (the
# Express server in server/, or the identical handlers embedded in the
# application server) uses it; the browser never sees it. Create a free
# cluster at mongodb.com/atlas, allow your IP under Network Access and
# create a database user first. Leave empty to run fully offline on
# IndexedDB (the app detects it and falls back automatically).
MONGODB_URI=
MONGODB_DB=qmate
QMATE_API_PORT=4000

# ── Mail & verification tier (email OTP + security alerts) ──────────────
# The application server sends verification codes and alert emails over
# SMTP. A Gmail App Password works well (Google Account → Security →
# 2-Step Verification → App passwords). Environment values always win
# over the built-in defaults.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QMATE <your-address@example.edu>
# Public URL used in email footers / call-to-action links
MAIL_APP_URL=https://qmate.space-z.ai/qmate/
# Signing secret for verification receipts (any long random string)
MAIL_SECRET=
# Set to 'off' to hard-fail sign-up when SMTP is down (default: the code
# is shown on screen so the flow stays usable during outages)
QMATE_OTP_FALLBACK=on
