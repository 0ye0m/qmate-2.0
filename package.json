{
  "name": "qmate-2.0",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Q-Mate 2.0 — Sustainable Smart Campus Queue Platform. React 18 + Vite frontend, Express + MongoDB Atlas data API (cloud persistence), Dexie/IndexedDB offline fallback, BroadcastChannel realtime, Gemini AI features.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently -k -n client,api -c cyan,green \"vite\" \"node server/index.js\"",
    "build": "vite build && node scripts/write-version.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.8",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.453.0",
    "mongodb": "^6.22.0",
    "nodemailer": "^6.9.16",
    "qrcode.react": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2"
  }
}
